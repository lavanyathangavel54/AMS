# Absolute backend URL for production deployments (leave empty for same-origin /api).
VITE_API_BASE_URL=

# Backend URL used by the Vite dev-server proxy.
VITE_API_PROXY_TARGET=http://localhost:5000

# Allows role accounts to sign in when the backend is not running.
# Set to false in production when a real backend is always available.
VITE_LOCAL_AUTH=true

# Local development logins (only used when VITE_LOCAL_AUTH is enabled):
# Admin:    admin@ams.local / Admin@123
# HR:       hr@ams.local / Hr@12345
# Manager:  manager@ams.local / Manager@123
# Employee: employee@ams.local / Employee@123
